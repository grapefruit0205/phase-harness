{
  "schema_version": 2,
  "state_dir": ".orchestrator/v2",
  "timeout_seconds": 1800,
  "roles": {
    "implement": {"model": "gpt-5.6-sol", "reasoning_effort": "medium"},
    "verify": {"model": "gpt-6-astra", "reasoning_effort": "high"}
  },
  "fingerprint_policy": {
    "ignored_directories": ["tmp"],
    "ignored_files": ["local.settings"]
  },
  "phases": [
    {
      "id": "P01",
      "name": "Synthetic feature",
      "instruction": "phases/P01.md",
      "verification_report": "reports/P01-verification.md",
      "dependencies": [],
      "mandatory_checks": {
        "implement": ["unit"],
        "verify": ["acceptance"]
      },
      "fingerprint_groups": {
        "product": ["src"],
        "tests": ["tests"],
        "dependencies": ["pyproject.toml"],
        "current_phase": ["phases/P01.md"],
        "design": ["design/P01.md"],
        "source": ["fixtures"]
      }
    }
  ]
}
